# =========================================================================
# CleanLoop MVP: Docker Compose Environment Configuration
# Copy this file to `.env` to customize your local Docker environment.
# =========================================================================

# Port configuration
FRONTEND_PORT=3000
DYNAMODB_PORT=8000
DYNAMODB_ADMIN_PORT=8001

# AWS Configuration (Local or Cloud)
AWS_REGION=us-east-1
TABLE_NAME=CleanLoopTable

# Live AWS Connection (Optional)
# If left blank, frontend runs in local demonstration mode using browser storage and mock API.
# If connecting to deployed CDK stack, copy values from `infra/cdk-outputs.json` or `frontend/.env.local`.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_S3_BUCKET=
